# Local booking-engine database (see docker-compose.yml).
DATABASE_URL=postgres://collabix:collabix@localhost:5432/collabix

# --- Hosted (Supabase) ---------------------------------------------------
# The app runtime uses the transaction-mode pooler (port 6543, IPv4-safe for
# serverless/Vercel). Always append `?sslmode=require`.
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
#
# Schema migrations and seeding must NOT use 6543 (no prepared statements /
# session support). Use the session pooler (port 5432) for `db:migrate`/`db:seed`:
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Dev only: set to `true` to leave the /admin panel open (no staff sign-in).
# Leave unset in production to keep the auth guard active.
# ADMIN_AUTH_DISABLED=true

# Transactional email (OTP codes). With no SMTP_HOST the app logs emails to the
# server console (dev). Set these to send for real via any SMTP provider
# (AWS SES SMTP, SendGrid, Mailgun, Postmark…). SMS OTP still needs a separate
# provider (e.g. Twilio) — not wired here.
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Collabix <no-reply@collabix.com>"

# Payments (invoices). With no keys the app runs in manual mode — staff mark
# invoices paid by hand. Set both to enable Razorpay order creation.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
