# Local booking-engine database (see docker-compose.yml).
DATABASE_URL=postgres://collabix:collabix@localhost:5432/collabix

# --- Hosted (Supabase) ---------------------------------------------------
# The app runtime uses the transaction-mode pooler (port 6543, IPv4-safe for
# serverless/Vercel). Always append `?sslmode=require`.
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
#
# Schema migrations and seeding must NOT use 6543 (no prepared statements /
# session support). Use the session pooler (port 5432) for `db:migrate`/`db:seed`:
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Dev only: set to `true` to leave the /admin panel open (no staff sign-in).
# Leave unset in production to keep the auth guard active.
# ADMIN_AUTH_DISABLED=true

# Transactional email (OTP codes). With no SMTP_HOST the app logs emails to the
# server console (dev). Set these to send for real via any SMTP provider
# (AWS SES SMTP, SendGrid, Mailgun, Postmark…). SMS OTP still needs a separate
# provider (e.g. Twilio) — not wired here.
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Collabix <no-reply@collabix.com>"

# Online booking checkout (Cashfree Payment Gateway). Public bookings are paid
# before they are confirmed. Keys come from merchant.cashfree.com → Developers
# → API Keys (use the Test environment's keys with CASHFREE_ENV=sandbox).
# CASHFREE_ENV=sandbox            # sandbox | production
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# Cashfree posts payment webhooks here; must be HTTPS. Defaults to
# <SITE_URL>/api/payments/cashfree/webhook when SITE_URL is https, else unset
# (local dev relies on the browser-driven confirm instead).
# CASHFREE_WEBHOOK_URL=
# Dev only: confirm bookings without collecting payment (tickets read "Pay at
# desk"). Never set this in production.
# PAYMENTS_DISABLED=true

# SMS one-time codes (login and checkout) via Fast2SMS: Dashboard → API Key.
# Without it, development prints codes to the server console; production
# refuses to send. Quick SMS route, no DLT registration needed.
# FAST2SMS_API_KEY=

# Message Central VerifyNow (preferred for SMS codes): they generate, text and
# check the code under their own DLT registration. Console → Developer Guide →
# API Credentials. When both are set they replace Fast2SMS.
# MESSAGECENTRAL_CUSTOMER_ID=
# MESSAGECENTRAL_AUTH_TOKEN=
